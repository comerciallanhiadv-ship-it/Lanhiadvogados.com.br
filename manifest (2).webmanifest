{
  "name": "Lanhi Advogados",
  "short_name": "Lanhi Advogados",
  "description": "Advocacia previdenciária para o trabalhador acidentado. Acompanhe seu processo na Área do Cliente e fale com o escritório.",
  "id": "/",
  "start_url": "/?app=1",
  "scope": "/",
  "display": "standalone",
  "background_color": "#07101f",
  "theme_color": "#07101f",
  "lang": "pt-BR",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Lanhi Advogados Cliente",
      "short_name": "Meu processo",
      "url": "/cliente/",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "categories": [
    "business",
    "productivity"
  ],
  "dir": "ltr",
  "prefer_related_applications": false,
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "screenshots": [
